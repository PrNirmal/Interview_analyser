# Required to start the API. Settings load this even when LLM_PROVIDER is huggingface.
OPENROUTER_API_KEY=your_openrouter_api_key

# LLM. Provider is "openrouter" or "huggingface".
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
LLM_PROVIDER=openrouter
LLM_MODEL=inclusionai/ling-3.0-flash-fin:free
HF_LLM_MODEL=Qwen/Qwen2.5-3B-Instruct

# Embeddings. Provider is "huggingface" or "openrouter".
EMBEDDING_PROVIDER=huggingface
HF_EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_MODEL=nvidia/llama-nemotron-embed-vl-1b-v2:free

# Local Chroma collection used by semantic retrieval.
CHROMA_PATH=storage/chroma
CHROMA_COLLECTION=expert_transcripts
RETRIEVAL_TOP_K=5

# Optional. Comma-separated browser origins. When unset, the API allows
# localhost and 127.0.0.1 on ports 5172, 5173, and 3000.
# CORS_ALLOWED_ORIGINS=http://127.0.0.1:5172,http://localhost:5172
